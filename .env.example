# TenderBot Monorepo Environment Variables
# Copy this file to .env and fill in your values

# Convex
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# See apps/web/.env.example for Next.js specific variables
# LLM configuration
# Set to true to enable full-context analysis (joins all chunks per doc)
LLM_FULL_CONTEXT=true
# Override the model used for analysis (defaults to gpt-4.1)
LLM_MODEL=gpt-4.1
