# Convex Environment Variables

# AI/LLM APIs (used in Convex actions)
# Set OPENAI_BASE_URL to your Azure endpoint (e.g. https://<resource>.openai.azure.com/openai)
# and OPENAI_API_VERSION to the matching API version when using Azure OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_VERSION=
COHERE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Storage (optional Cloudflare R2 replication)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LLM configuration overrides for bundle analysis
# Enable to pass entire document text to GPT-4.1
LLM_FULL_CONTEXT=false
# Explicit model selection for analysis (e.g., gpt-4.1, gpt-4.1-turbo)
LLM_MODEL=gpt-4.1
