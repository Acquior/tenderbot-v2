# Convex Environment Variables

# AI/LLM APIs (used in Convex actions)
# Option 1: OpenAI directly
OPENAI_API_KEY=

# Option 2: Azure OpenAI (recommended for enterprise)
# Set these for Azure OpenAI instead of OPENAI_API_KEY
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4-turbo
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Document Intelligence (for OCR fallback on scanned PDFs)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Other LLM providers
COHERE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Storage (optional Cloudflare R2 replication)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LLM configuration overrides for bundle analysis
# Enable to pass entire document text to GPT-4.1
LLM_FULL_CONTEXT=false
# Explicit model selection for analysis (e.g., gpt-4.1, gpt-4.1-turbo)
LLM_MODEL=gpt-4.1
